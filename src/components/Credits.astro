---
import {
  parseBlocks,
  parseCredits,
  SUPPORT_PATTERN,
  type CreditRow,
} from "@/lib/credits";

interface Props {
  credits: { left: string; right: string };
}

const { credits } = Astro.props;

const LABEL_CLASS =
  "text-[9px] font-medium uppercase leading-[13px] tracking-[0.09em] opacity-75";

const left = credits.left.trim();
const right = credits.right.trim();

type ColumnModel =
  | { kind: "none" }
  | { kind: "fields"; rows: CreditRow[] }
  | { kind: "blocks"; blocks: string[][] }
  | { kind: "support"; support: string[]; screenings: string[] };

function buildColumn(text: string): ColumnModel {
  const rows = parseCredits(text);

  if (rows.length === 0) {
    return { kind: "none" };
  }

  const hasLabels = rows.some(
    (row) => row.kind === "field" && row.label !== null,
  );

  if (hasLabels) {
    return { kind: "fields", rows };
  }

  const blocks = parseBlocks(text);
  const hasSupport =
    blocks.length > 0 && SUPPORT_PATTERN.test(blocks[0][0] ?? "");

  if (!hasSupport) {
    return { kind: "blocks", blocks };
  }

  const support: string[] = [];
  const screenings: string[] = [];

  blocks.forEach((block, blockIndex) => {
    if (blockIndex === 0) {
      block.forEach((line, lineIndex) => {
        const value =
          lineIndex === 0 ? line.replace(SUPPORT_PATTERN, "") : line;
        if (value) {
          support.push(value);
        }
      });
    } else {
      screenings.push(...block);
    }
  });

  return { kind: "support", support, screenings };
}

const columns = [
  { text: left, model: buildColumn(left) },
  { text: right, model: buildColumn(right) },
].filter((column) => column.text.length > 0);
---

{columns.length > 0 && (
  <div class="grid grid-cols-5 px-[32px] text-[11px] leading-[13px] text-ink max-md:grid-cols-1 max-md:text-xs max-md:leading-[15px]">
    <div class="col-span-3 col-start-3 grid grid-cols-2 gap-x-[24px] max-md:col-span-1 max-md:col-start-1 max-md:grid-cols-1 max-md:gap-y-5">
      {columns.map((column) => (
        <div>
          {column.model.kind === "fields" && (
            <dl class="grid grid-cols-[max-content_1fr] items-baseline gap-x-3.5">
              {column.model.rows.map((row) =>
                row.kind === "break" ? (
                  <div aria-hidden="true" class="col-span-2 h-2.5" />
                ) : (
                  <>
                    <dt class={LABEL_CLASS}>{row.label}</dt>
                    <dd class="leading-[13px]">{row.value}</dd>
                  </>
                ),
              )}
            </dl>
          )}
          {column.model.kind === "blocks" && (
            <>
              {column.model.blocks.map((block, index) => (
                <p class={index > 0 ? "mt-3" : undefined}>
                  {block.map((line, lineIndex) => (
                    <>
                      {lineIndex > 0 ? <br /> : null}
                      {line}
                    </>
                  ))}
                </p>
              ))}
            </>
          )}
          {column.model.kind === "support" && (
            <dl class="grid grid-cols-[max-content_1fr] items-baseline gap-x-3.5">
              {column.model.support.length > 0 && (
                <>
                  <dt class={LABEL_CLASS}>Support</dt>
                  <dd class="leading-[13px]">
                    {column.model.support.map((line) => (
                      <div>{line}</div>
                    ))}
                  </dd>
                </>
              )}
              {column.model.screenings.length > 0 && (
                <>
                  <dt class={LABEL_CLASS}>Screenings</dt>
                  <dd class="leading-[13px]">
                    {column.model.screenings.map((line) => (
                      <div>{line}</div>
                    ))}
                  </dd>
                </>
              )}
            </dl>
          )}
        </div>
      ))}
    </div>
  </div>
)}
